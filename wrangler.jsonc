{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outils",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "outils.poirierlavoie.ca",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "logpush": false,
  "vars": {
    "COMMIT": "inconnu"
  },
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_TERMINOLOGIE",
      "database_name": "outils-terminologie-20261119",
      "database_id": "b461fe21-9c80-47a0-bb26-508336da9230"
    },
    {
      "binding": "DB_REGISTRES",
      "database_name": "outils-registres",
      "database_id": "fe4ed9ca-2b31-4409-a3ee-547dbb9d4e51"
    },
    {
      "binding": "DB_ADRESSES",
      "database_name": "outils-adresses",
      "database_id": "33d23283-82d6-40e8-a37e-cbd6bb41d6e0"
    },
    {
      "binding": "DB_ECONOMIE",
      "database_name": "outils-economie",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
