{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outils",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "outils.poirierlavoie.ca",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "logpush": false,
  "vars": {
    "COMMIT": "inconnu",
    "MCP_ENABLED": "true",
    "ORIGINE_PORTAIL": "https://acces.poirierlavoie.ca",
    "ALLOWED_ORIGINS": "https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,https://platform.openai.com,https://gemini.google.com,https://aistudio.google.com,https://console.cloud.google.com"
  },
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  },
  "ratelimits": [
    {
      "name": "RL_PRE_AUTH_IP",
      "namespace_id": "1041",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RL_ECHEC_IP",
      "namespace_id": "1042",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RL_ECHECS_GLOBAL",
      "namespace_id": "1043",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "RL_TITULAIRE",
      "namespace_id": "1044",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "RL_TITULAIRE_LIMITE",
      "namespace_id": "1045",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB_TERMINOLOGIE",
      "database_name": "outils-terminologie-20261119",
      "database_id": "b461fe21-9c80-47a0-bb26-508336da9230"
    },
    {
      "binding": "DB_REGISTRES",
      "database_name": "outils-registres",
      "database_id": "fe4ed9ca-2b31-4409-a3ee-547dbb9d4e51"
    },
    {
      "binding": "DB_ADRESSES",
      "database_name": "outils-adresses",
      "database_id": "33d23283-82d6-40e8-a37e-cbd6bb41d6e0"
    },
    {
      "binding": "DB_ECONOMIE",
      "database_name": "outils-economie",
      "database_id": "ccbf7519-97c8-4f48-a190-09071d2559ad"
    },
    {
      "binding": "DB_IDENTITE",
      "database_name": "mcp-identite",
      "database_id": "ee4894cc-a779-466b-bc9b-ac157b354afc"
    }
  ]
}
